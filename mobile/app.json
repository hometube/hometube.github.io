{
  "expo": {
    "name": "HomeTube",
    "slug": "hoekz",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hometube",
    "icon": "./assets/foreground-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#af1bac"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "com.hometube.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#af1bac",
        "foregroundImage": "./assets/foreground-icon.png",
        "backgroundImage": "./assets/background-gradient.png",
        "monochromeImage": "./assets/foreground-icon.png"
      },
      "package": "com.hometube.app",
      "versionCode": 4,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      "expo-sharing",
      "expo-splash-screen",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af93146f-5f07-44ef-a47a-30588a796c2e"
      }
    },
    "owner": "hoekzema-clan"
  }
}
